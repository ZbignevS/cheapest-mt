{
  "name": "db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "apps/db/src",
  "tags": [
    "type:data",
    "scope:db"
  ],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run build",
        "cwd": "apps/db"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev",
        "cwd": "apps/db",
        "env": {
          "PORT": "3333"
        }
      },
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc -p tsconfig.json --noEmit",
        "cwd": "apps/db"
      }
    },
    "contract-emit": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run contract:emit",
        "cwd": "apps/db"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run migrate",
        "cwd": "apps/db"
      }
    },
    "migration:status": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run migration:status",
        "cwd": "apps/db"
      }
    }
  }
}
